# ── Qistas environment — copy to .env and fill in ───────────
# NEVER commit a real .env (see .gitignore). Real prod secrets
# are injected by the deployment platform (docs/adr/0026).

# Which settings module to load.
DJANGO_SETTINGS_MODULE=config.settings.dev

# 50+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ── Database (docker-compose provides this host by default) ──
DATABASE_URL=postgres://qistas:qistas@db:5432/qistas
DJANGO_CONN_MAX_AGE=60

# ── Sessions / idle timeout ────────────────────────────────
DJANGO_SESSION_COOKIE_AGE=28800
QISTAS_IDLE_TIMEOUT_SECONDS=1800
QISTAS_TIME_ZONE=Asia/Hebron

# ── django-axes (lock by username only) ────────────────────
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.5

# ── MFA (enrollment not forced in v1 — docs/adr/0017; completion IS forced once enrolled) ─
QISTAS_REQUIRE_MFA=false
QISTAS_MFA_ENFORCED_GROUPS=

# ── Audit ─────────────────────────────────────────────────
# Only set true when a trusted reverse proxy strips + re-sets X-Forwarded-For.
QISTAS_AUDIT_TRUST_XFF=false

# ── Passwords ─────────────────────────────────────────────
DJANGO_PASSWORD_MIN_LENGTH=10

# ── Email (console backend in dev; real SMTP is Phase 14) ──
DJANGO_DEFAULT_FROM_EMAIL=qistas@example.com

# ── Dev extras ────────────────────────────────────────────
QISTAS_ENABLE_DEBUG_TOOLBAR=false

# ── Production-only (ignored in dev) ──────────────────────
# DJANGO_CSRF_TRUSTED_ORIGINS=https://qistas.example.ps
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
